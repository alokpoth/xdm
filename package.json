{
  "name": "xdm",
  "version": "1.0.11",
  "description": "XDM Turbo - Minimal, Modern, Multi-threaded Internet Download Manager with 64-stream parallel acceleration & browser video grabber",
  "author": "Zihan Fakir (https://xdm.zihan.xyz)",
  "homepage": "https://xdm.zihan.xyz",
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/zihanfakir/xdm.git"
  },
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"node server/server.js\" \"vite\"",
    "server": "node server/server.js",
    "vite": "vite",
    "electron": "electron electron/main.js",
    "app": "concurrently -k \"vite\" \"electron electron/main.js\"",
    "build": "vite build",
    "build:bytecode": "node scripts/build-bytecode.js",
    "restore:source": "node scripts/restore-source.js",
    "test": "node --test --test-concurrency=1 tests/download-engine.test.js tests/license-system.test.js",
    "test:control-center": "node scripts/test-control-center.js",
    "test:all": "node scripts/test-control-center.js all",
    "dist:win": "vite build && node scripts/build-bytecode.js && electron-builder --win && powershell -ExecutionPolicy Bypass -File scripts/create-and-sign.ps1 && node scripts/restore-source.js"
  },
  "build": {
    "appId": "com.xdm.turbomanager",
    "productName": "XDM Turbo",
    "asar": true,
    "electronFuses": {
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "runAsNode": false,
      "enableNodeCliInspectArguments": false,
      "enableNodeOptionsEnvironmentVariable": false
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "public/**/*",
      "server/**/*",
      "!server/bin/**/*",
      "electron/**/*",
      "!**/*.orig",
      "!**/*.bak",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "extension",
        "to": "extension"
      },
      {
        "from": "server/bin",
        "to": "server/bin"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "shortcutName": "XDM Turbo",
      "uninstallDisplayName": "XDM Turbo Download Manager",
      "differentialPackage": false,
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "include": "installer/customInstaller.nsh"
    }
  },
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "bytenode": "^1.7.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "overrides": {
    "braces": ">=3.0.3",
    "postcss-selector-parser": ">=7.1.6"
  }
}
