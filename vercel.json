{
  "outputDirectory": "docs",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/owner",
      "destination": "/owner.html"
    },
    {
      "source": "/owner/(.*)",
      "destination": "/owner.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    }
  ]
}
